{
  "name": "molecule-jury",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "postinstall": "node scripts/copy-rdkit.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "brain:train": "python scripts/train_brain.py",
    "brain:parity": "tsx scripts/check-parity.ts",
    "eval:live": "node scripts/eval-live.mjs",
    "db:integrity": "node --env-file=.env.local scripts/check-integrity.mjs",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs *.json *.yaml README.md",
    "format:check": "prettier --check app components lib scripts tests *.ts *.mjs *.json *.yaml README.md"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@fontsource/dm-sans": "latest",
    "@fontsource/jetbrains-mono": "latest",
    "@fontsource/space-grotesk": "latest",
    "@rdkit/rdkit": "latest",
    "3dmol": "latest",
    "ai": "^5.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "radix-ui": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  }
}
